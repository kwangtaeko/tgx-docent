<?xml version="1.0" encoding="utf-8"?>
<!-- 픽스처용 가짜 설정. docent는 이 파일을 읽지 않는다. -->
<configuration>
  <connectionStrings>
    <add name="OrderDb" connectionString="Server=db.example.local;Database=Orders;User Id=app;Password=docent-fixture-not-secret;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" defaultUrl="~/Default.aspx" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>
  <location path="Account/Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
