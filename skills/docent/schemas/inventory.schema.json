{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kwangtaeko/tgx-docent/schemas/inventory.schema.json",
  "title": "docent inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "screens"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "string",
      "pattern": "^[^:\\\\]+:(\\d+(-\\d+)?|[A-Za-z_$][\\w$.]*)$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "kind",
        "files",
        "evidence",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "page",
            "modal",
            "popup",
            "view"
          ]
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relPath"
          }
        },
        "menuPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source": {
          "type": "string",
          "pattern": "^(detector:[a-z0-9-]+|agent|crawl)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "page"
              }
            }
          },
          "then": {
            "properties": {
              "route": {
                "type": "string"
              }
            }
          },
          "else": {
            "required": [
              "parentId"
            ]
          }
        }
      ]
    },
    "relPath": {
      "type": "string",
      "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|$))(?!.*//)[^\\\\:]+$"
    }
  }
}
