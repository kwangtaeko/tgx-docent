{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kwangtaeko/tgx-docent/schemas/screen.schema.json",
  "title": "docent screen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "route",
    "title",
    "purpose",
    "roles",
    "sections",
    "fields",
    "actions",
    "messages",
    "unknowns",
    "readFiles",
    "sourceHash"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "page",
        "modal",
        "popup",
        "view"
      ]
    },
    "parentId": {
      "$ref": "#/$defs/id"
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "menuPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "메뉴 이름들(위 단계부터). 이름마다 근거 근처에 글자가 있어야 한다"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "moreEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "description": "메뉴 경로의 이름이 여러 곳에 나뉘어 있을 때(그룹 이름은 프론트, 메뉴 이름은 DB 등) 나머지 위치. value의 이름마다 evidence나 moreEvidence 중 한 곳 근처에 글자가 있어야 한다"
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "evidence",
          "confidence"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "type",
          "required",
          "evidence",
          "confidence"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "textarea",
              "number",
              "date",
              "select",
              "checkbox",
              "radio",
              "file",
              "password",
              "email",
              "url",
              "tel",
              "other"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "section": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "고정된 선택지(화면 문구 그대로). 근거 근처에 글자가 있어야 한다"
          },
          "optionsEvidence": {
            "$ref": "#/$defs/evidence",
            "description": "선택지가 라벨과 떨어진 곳(상수·코드표 등)에 정의돼 있으면 그 위치. 있으면 options는 이 근처에서 확인한다"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "effect",
          "evidence",
          "confidence"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "navigatesTo": {
            "$ref": "#/$defs/id"
          },
          "opens": {
            "$ref": "#/$defs/id"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "section": {
            "type": "string",
            "description": "같은 라벨이 여러 구획에 있을 때 구분하는 구획 제목(sections의 title)"
          },
          "effectEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "description": "버튼 결과(effect)를 뒷받침하는 다른 위치(처리 함수, 메인 프로세스 등). evidence는 라벨이 있는 줄"
          },
          "unlabeled": {
            "const": true,
            "description": "화면에 글자가 없는 동작(표의 행 클릭, 카드 클릭 등). label은 동작을 짧게 설명한 말(예: '행 클릭')이고 글자 검사를 하지 않는다. evidence는 그 처리기(onClick 등)가 있는 줄"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "when",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "description": "같은 종류의 문구 묶음 이름(상태 코드·검사 결과 문구 표 등). 같은 group은 표 하나로 보인다"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relPath"
      }
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "type": "string"
          }
        }
      },
      "else": {
        "required": [
          "parentId"
        ]
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "string",
      "pattern": "^[^:\\\\]+:(\\d+(-\\d+)?|[A-Za-z_$][\\w$.]*)$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "relPath": {
      "type": "string",
      "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|$))(?!.*//)[^\\\\:]+$"
    }
  }
}
